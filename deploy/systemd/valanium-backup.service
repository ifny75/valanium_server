# /etc/systemd/system/valanium-backup.service
#
# Снимок базы. Обычный cp здесь не годится: база в режиме WAL, и файл, снятый
# во время записи, окажется битым. Инструмент делает VACUUM INTO — консистентный
# снимок на работающем сервере, без остановки.
#
# Путь к node указан явно и намеренно не системный: серверу нужен 24+, а
# системный обычно старее. systemd ищет ExecStart без подстановки PATH, и
# промах виден только в журнале — таймер бэкапа уже падал так двое суток
# подряд, пока никто не смотрел. Ставите node в другое место — правьте здесь.

[Unit]
Description=Valanium backup snapshot
After=valanium.service

# Снимок сделан — отправляем копию наружу. Именно OnSuccess, а не Wants:
# отправлять нечего, если снимок не удался, и незачем поднимать шум дважды
# об одной и той же поломке.
OnSuccess=valanium-offsite.service

[Service]
Type=oneshot
User=valanium
Group=valanium
WorkingDirectory=/opt/valanium
ExecStart=/opt/node-24/bin/node --env-file-if-exists=.env src/tools/backup.ts /var/backups/valanium

# Сколько снимков держать. Старые чистятся сами.
Environment=VALANIUM_BACKUP_KEEP=14

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/valanium/data /var/backups/valanium

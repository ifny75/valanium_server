# /etc/systemd/system/valanium-offsite.service
#
# Отправка снимка на второй узел. Запускается не таймером, а по успеху
# valanium-backup.service (OnSuccess=): отправлять нечего, пока снимок не снят.
#
# Отдельным юнитом, а не ExecStartPost внутри бэкапа, по двум причинам.
# Во-первых, снимок и отправка — разные факты: упавшая отправка не должна
# выглядеть как «бэкапа нет». Во-вторых, песочница у них разная — бэкапу
# нужен доступ к базе, отправке к сети и ключам, и смешивать их права незачем.

[Unit]
Description=Valanium offsite snapshot shipment
After=valanium-backup.service

[Service]
Type=oneshot
User=valanium
Group=valanium
WorkingDirectory=/opt/valanium
# ssh ищет свои файлы относительно HOME, а ProtectHome его прячет.
Environment=HOME=/opt/valanium
ExecStart=/usr/local/bin/valanium-offsite.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Единственное место, куда пишем: временный шифротекст перед отправкой.
# Каталог должен существовать заранее — при ProtectSystem=strict создать его
# на лету уже нельзя.
# Плюс отметка об успешной отправке: по её свежести самопроверка узнаёт,
# что копия действительно уехала.
ReadWritePaths=/var/backups/valanium-outbox /opt/valanium/data/offsite
